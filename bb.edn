{:paths ["src"]
 :deps  {cheshire/cheshire         {:mvn/version "5.13.0"}
         org.babashka/http-server  {:mvn/version "0.1.13"}}
 :tasks {fetch  {:doc      "Fetch tweets for all accounts into tmp/feed.edn"
                 :requires ([bbitter.fetch :as fetch])
                 :task     (fetch/-main)}
         render {:doc      "Render tmp/feed.edn into public/"
                 :requires ([bbitter.render :as render])
                 :task     (render/-main)}
         build  {:doc     "Fetch then render"
                 :depends [fetch render]}
         serve  {:doc      "Serve public/ locally for preview"
                 :requires ([babashka.http-server :as http-server])
                 :task     (do (http-server/serve {:port 1889 :dir "public"})
                               (deref (promise)))}}}
